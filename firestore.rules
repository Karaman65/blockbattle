rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnlyAllowedKeys(data, allowedKeys) {
      return data.keys().hasOnly(allowedKeys);
    }

    function keepsPremiumUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isPremium', 'premiumBonusGranted', 'premiumPurchasedAt', 'fulfilledPurchases'
      ]);
    }

    function keepsIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'createdAt']);
    }

    function keepsEconomyUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'coins', 'inventory', 'highScore', 'unlockedLevel',
        'totalGames', 'totalWins', 'totalOnlineGames',
        'quickOnlineGames', 'quickWins', 'quickLosses', 'quickDraws',
        'ownedThemes', 'ownedCosmetics',
        'claimedQuests', 'dailyRewardLastClaim', 'dailyRewardStreak', 'dailyRewardLastIndex'
      ]);
    }

    function onlyCosmeticPrefsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['avatar', 'boardBackground', 'uiTheme']);
    }

    function coinIncreaseAtMost(maxAmount) {
      return request.resource.data.coins is number
        && resource.data.coins is number
        && request.resource.data.coins >= resource.data.coins
        && request.resource.data.coins - resource.data.coins <= maxAmount;
    }

    function onlyClientRewardClaimChanged() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return (
        keys.hasOnly(['coins', 'claimedQuests'])
        && coinIncreaseAtMost(3000)
      ) || (
        keys.hasOnly(['coins', 'dailyRewardLastClaim', 'dailyRewardStreak', 'dailyRewardLastIndex'])
        && coinIncreaseAtMost(700)
      );
    }

    function inventoryValue(data, key) {
      return data.inventory.get(key, 0);
    }

    function inventoryHasNumbers(data) {
      return data.inventory is map
        && data.inventory.keys().hasOnly(['bomb', 'rotate', 'skip'])
        && inventoryValue(data, 'bomb') is number
        && inventoryValue(data, 'rotate') is number
        && inventoryValue(data, 'skip') is number;
    }

    function onePowerUpIncrement(type) {
      return inventoryValue(request.resource.data, type) == inventoryValue(resource.data, type) + 1
        && (type == 'bomb' || inventoryValue(request.resource.data, 'bomb') == inventoryValue(resource.data, 'bomb'))
        && (type == 'rotate' || inventoryValue(request.resource.data, 'rotate') == inventoryValue(resource.data, 'rotate'))
        && (type == 'skip' || inventoryValue(request.resource.data, 'skip') == inventoryValue(resource.data, 'skip'));
    }

    function onlyClientPowerUpSpendChanged() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let spent = resource.data.coins - request.resource.data.coins;
      return keys.hasOnly(['coins', 'inventory'])
        && resource.data.coins is number
        && request.resource.data.coins is number
        && request.resource.data.coins >= 0
        && inventoryHasNumbers(resource.data)
        && inventoryHasNumbers(request.resource.data)
        && (
          (spent == 280 && onePowerUpIncrement('bomb'))
          || (spent == 150 && onePowerUpIncrement('rotate'))
          || (spent == 220 && onePowerUpIncrement('skip'))
        );
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if request.query.limit <= 1;
      allow create: if isOwner(uid)
        && hasOnlyAllowedKeys(request.resource.data, [
          'username', 'email', 'highScore', 'coins', 'unlockedLevel',
          'inventory', 'totalGames', 'totalWins', 'totalOnlineGames',
          'createdAt', 'ownedThemes', 'ownedCosmetics',
          'quickOnlineGames', 'quickWins', 'quickLosses', 'quickDraws'
        ]);
      allow update: if isOwner(uid)
        && keepsPremiumUnchanged()
        && keepsIdentityUnchanged()
        && (
          (keepsEconomyUnchanged() && onlyCosmeticPrefsChanged())
          || onlyClientRewardClaimChanged()
          || onlyClientPowerUpSpendChanged()
        );
      allow delete: if false;
    }

    match /usernames/{usernameKey} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && hasOnlyAllowedKeys(request.resource.data, ['uid', 'username', 'createdAt']);
      allow update, delete: if false;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn()
        && (resource.data.player1.uid == request.auth.uid || resource.data.player2.uid == request.auth.uid);
      allow create: if isSignedIn()
        && (
          request.resource.data.player1.uid == request.auth.uid
          || request.resource.data.player2.uid == request.auth.uid
        );
      allow update, delete: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 800;
      allow update, delete: if false;
    }
  }
}

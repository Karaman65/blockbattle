rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function onlyVisualPreferencesChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['avatar', 'boardBackground', 'uiTheme']);
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;
      // Profiles and all economy/progression fields are created by Cloud Functions.
      allow create: if false;
      allow update: if isOwner(uid) && onlyVisualPreferencesChanged();
      allow delete: if false;
    }

    match /usernames/{usernameKey} {
      // Never expose username-to-account mappings or email addresses to clients.
      allow read, write: if false;
    }

    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /matches/{matchId} {
      allow read: if isSignedIn()
        && (resource.data.player1.uid == request.auth.uid
          || resource.data.player2.uid == request.auth.uid);
      // Match records must be written by an authenticated game server.
      allow write: if false;
    }

    match /feedback/{feedbackId} {
      allow read: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'username', 'type', 'message', 'appVersion', 'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 3
        && request.resource.data.username.size() <= 16
        && request.resource.data.email is string
        && request.resource.data.type in ['bug', 'suggestion', 'account', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 5
        && request.resource.data.message.size() <= 800
        && request.resource.data.appVersion == '1.0'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /gameSessions/{sessionId} {
      allow read, write: if false;
    }

    match /verifiedPurchases/{purchaseId} {
      allow read, write: if false;
    }

    match /onlineMatchClaims/{claimId} {
      allow read, write: if false;
    }
  }
}
